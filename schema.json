{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeakLens Registry Entry",
  "description": "Schema for a verified data breach record",
  "type": "object",
  "required": ["slug", "title", "institution", "status", "sources"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case unique identifier (e.g. paidwork-2026)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Human-readable breach title"
    },
    "institution": {
      "type": "string",
      "minLength": 2,
      "description": "Company or organization name"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Breach date (YYYY-MM-DD)"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of exposed records (0 if unknown)"
    },
    "status": {
      "type": "string",
      "enum": ["verified", "confirmed", "disputed", "unconfirmed"],
      "description": "Verification status"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"],
      "description": "Breach severity level"
    },
    "exposedData": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Types of exposed data (e.g. Email addresses, Passwords)"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "Brief description of the breach"
    },
    "methodology": {
      "type": "string",
      "description": "How this breach was discovered/verified"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "publisher"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Source URL"
          },
          "title": {
            "type": "string",
            "description": "Source article title"
          },
          "publisher": {
            "type": "string",
            "description": "Publisher name (e.g. OCCRP, The Register)"
          },
          "date": {
            "type": "string",
            "description": "Publication date"
          }
        }
      },
      "description": "Verification sources (at least 1 required)"
    },
    "referenceUrl": {
      "type": "string",
      "format": "uri",
      "description": "Primary reference URL"
    }
  },
  "additionalProperties": false
}
