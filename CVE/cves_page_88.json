        "https://github.com/backstage/backstage/commit/818528e112c36167d76187e9e63fb518399c4dd2",
        "https://github.com/backstage/backstage/releases/tag/v1.54.6",
        "https://github.com/advisories/GHSA-g8rx-f7m5-7794"
      ],
      "vulnerableProducts": [
